
@inherits LayoutComponentBase

@if (!isLoginPage)
{
    <MudThemeProvider />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>
        <MudAppBar>
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
            Admin
        </MudAppBar>
        <MudDrawer @bind-Open="@_drawerOpen">
            <NavMenu />
        </MudDrawer>
        <MudMainContent>
            @Body
        </MudMainContent>
    </MudLayout>
}else{
       <MudThemeProvider />

    <MudLayout>
        <MudMainContent>
            @Body
        </MudMainContent>
    </MudLayout>
}




@code {
    bool _drawerOpen = true;
    bool isLoginPage => Navigation.Uri.EndsWith("/login");
    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}

